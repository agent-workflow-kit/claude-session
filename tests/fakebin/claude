#!/usr/bin/env python3
"""Fake Claude Code for tests; the implementation and scenario format are in fake_claude.py."""

import os
import sys

# pyproject's requires-python; the fake uses Popen(process_group=...) and newer syntax.
MIN_PYTHON = (3, 12)
FAKE_ERROR = 99

if sys.version_info < MIN_PYTHON:
    sys.stderr.write(
        "fake claude: needs Python %d.%d or newer, not %s\n"
        % (*MIN_PYTHON, sys.version.split()[0])
    )
    sys.exit(FAKE_ERROR)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from fake_claude import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
